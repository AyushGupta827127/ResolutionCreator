# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Restart `npm run dev` after changing anything here.
#
# This app shares its backend with the `template` project: same Directus
# instance, same Firebase project, same Razorpay account. Values below that
# already point at the live finaceindia endpoints are NOT placeholders —
# leave them as-is unless you're intentionally pointing at a different
# instance. Values left blank ARE placeholders — fill them in.
# ---------------------------------------------------------------------------

# --- SMTP (transactional email + OTP delivery) — same mailbox as `template` ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Razorpay (credit purchases) — same account as `template` ---------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NUXT_RAZORPAY_KEY_ID=
NUXT_RAZORPAY_ENABLED=true

# --- Firebase Admin (server-side password reset) -----------------------------
# Service-account JSON for the `finaceindia-1d8d3` project, single line
# (raw or base64). Same project the `template` app uses.
FIREBASE_SERVICE_ACCOUNT=

# --- Directus / shared data layer --------------------------------------------
# These point at the SAME instance as `template` on purpose.
NUXT_DB_URL=https://db.finaceindia.com
NUXT_TEMP_DB_URL=https://temp.finaceindia.com
NUXT_DB_API_URL=https://temp.finaceindia.com
DIRECTUS_API_TOKEN=

# --- AI (Claude) ---------------------------------------------------------------
# Drives the one-question-at-a-time wizard, compliance narration, and the
# optional "refine wording" step. Leave blank to run in fully-deterministic
# mode (static question order, template-message compliance notes, no AI
# wording refinement) — the app still works end to end without this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
NUXT_AI_ENABLED=true

# --- Auth hardening --------------------------------------------------------------
# With FIREBASE_SERVICE_ACCOUNT set, saving / credits / e-mail requests are verified against the signed-in
# Firebase user. Set this to "true" in production so requests are REFUSED when verification isn't possible:
REQUIRE_VERIFIED_AUTH=

# ---------------------------------------------------------------------------
# DEPLOYING? Checklist for "login works on localhost but not on the live site"
#  1. Firebase console -> Authentication -> Settings -> Authorized domains: add your live domain.
#     (Google sign-in fails with auth/unauthorized-domain until you do. localhost is allowed by default.)
#  2. Google Cloud Console -> APIs & Services -> Credentials -> the Firebase browser API key:
#     if it has "HTTP referrer" restrictions, add https://your-domain/* .
#  3. Set the variables above on the SERVER'S environment (hosting dashboard / process manager). A local .env
#     file is git-ignored and is NOT deployed. Plain names (SMTP_USER, FIREBASE_SERVICE_ACCOUNT, ...) are read
#     at start-up; no rebuild needed.
#  4. Open https://your-domain/api/auth-check — it lists, as yes/no flags, what the server can see.
# ---------------------------------------------------------------------------
